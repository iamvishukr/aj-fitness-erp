# --- Required in production ---
# Postgres connection (Neon / Supabase / Railway). POSTGRES_URL also works. Leave empty to use the built-in local database in ./.data
DATABASE_URL=
# Long random string used to sign login sessions (generate: openssl rand -hex 32)
AUTH_SECRET=

# --- Admin login ---
# Creates the admin on first start. Changing these later (and redeploying) resets the admin's
# email/password and signs out all devices; a password changed in the app is kept until then.
ADMIN_EMAIL=admin@ajfitness.com
# Prefer a bcrypt hash: node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
ADMIN_PASSWORD_HASH=
# ...or a plain password (used only if ADMIN_PASSWORD_HASH is empty)
ADMIN_PASSWORD=
ADMIN_NAME=AJ
GYM_NAME=AJ Fitness

# --- Optional ---
GYM_TIMEZONE=Asia/Kolkata
EXPIRING_WINDOW_DAYS=7
NEXT_PUBLIC_COUNTRY_CODE=91
# Force the login cookie to Secure (true) or not (false). Default: automatic, based on https
COOKIE_SECURE=
