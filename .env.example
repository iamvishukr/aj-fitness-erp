# --- Required in production ---
# Postgres connection (Neon / Supabase / Railway). Leave empty to use the built-in local database in ./.data
DATABASE_URL=
# Long random string used to sign login sessions (generate: openssl rand -hex 32)
AUTH_SECRET=

# --- First admin account (created only on first start, when no admin exists) ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=AJ
GYM_NAME=AJ Fitness

# --- Optional ---
GYM_TIMEZONE=Asia/Kolkata
EXPIRING_WINDOW_DAYS=7
NEXT_PUBLIC_COUNTRY_CODE=91
# Force the login cookie to Secure (true) or not (false). Default: automatic, based on https
COOKIE_SECURE=
